# ==========================================
# TG-S3 Environment Configuration Example
# ==========================================

# ------------------------------------------
# Telegram MTProto User Account Credentials
# Get API ID and API Hash from https://my.telegram.org
# ------------------------------------------
TG_APP_ID=123456
TG_APP_HASH=0123456789abcdef0123456789abcdef

# MTProto String Session generated via `npm run login`
TG_SESSION=

# Telegram Supergroup / Channel ID where chunks will be stored (e.g. -1001234567890)
TG_GROUP_ID=-1001234567890

# ------------------------------------------
# Server & S3 API Credentials
# ------------------------------------------
PORT=3000
S3_ADMIN_KEY=admin
S3_ADMIN_SECRET=adminsecret
S3_REGION=us-east-1

# ------------------------------------------
# CAS & Storage Configuration
# ------------------------------------------
# Chunk Size in bytes (default: 10MB / 10485760 bytes)
CHUNK_SIZE=10485760

# Data Directories & SQLite Database Path
DATABASE_PATH=./data/tg-s3.db
DB_PATH=./data/tg-s3.db
CACHE_DIR=./data/cache
TEMP_DIR=./data/temp

# Cache & Retention Policy
LEAVE_IN_CACHE=false
CACHE_RETENTION_DAYS=7
HOT_CACHE_DAILY_THRESHOLD=10

